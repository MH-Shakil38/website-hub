APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
APP_MODE=saas
CENTRAL_DOMAINS=localhost,127.0.0.1,multi-website-hub.test
DASHBOARD_DOMAIN=app.multi-website-hub.test
SAAS_SERVER_IP=127.0.0.1
SAAS_CNAME_TARGET=sites.multi-website-hub.test
ACTIVE_MODULE=Interior

# First admin account created by `php artisan db:seed` (leave ADMIN_PASSWORD empty to generate a random one)
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Local-only: auto sign in the first Super Admin on /admin. Only works when APP_ENV=local. Keep false.
ADMIN_AUTO_LOGIN_LOCAL=false

# Prefix for per-tenant MySQL databases (hub_t_0001 ...). Tests use their own prefix (phpunit.xml).
TENANT_DB_PREFIX=hub_t_

# SSLCommerz online payments. Leave the store id/password empty to use the local-only simulator.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# ---------------------------------------------------------------------------
# PRODUCTION CHECKLIST (run `php artisan saas:doctor` on the server)
#   APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain
#   DB_CONNECTION=mysql, QUEUE_CONNECTION=database (+ queue worker), real MAIL_MAILER=smtp
#   SESSION_SECURE_COOKIE=true, SSLCOMMERZ_* live credentials, SSLCOMMERZ_SANDBOX=false
#   cron: * * * * * php /path/artisan schedule:run
# ---------------------------------------------------------------------------
